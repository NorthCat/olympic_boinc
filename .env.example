# Copy to .env and adjust. Settings for running the app outside Docker; all use the OLYMPIC_ prefix.
# The docker compose containers are configured in .docker-env instead (see .docker-env.example).
# Local PostgreSQL 18 (default). With `docker compose up -d db` use port 5433 and the credentials from .docker-env.
OLYMPIC_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/olympic_boinc

# Daily sync schedule (cron, UTC)
OLYMPIC_SYNC_CRON=0 3 * * *
OLYMPIC_SCHEDULER_ENABLED=true
# Also run the sync right after the app starts, then on schedule (each restart means another pass over the site)
OLYMPIC_SYNC_ON_STARTUP=false
# Challenge pages loaded per sync run, freshest first (the history is loaded over several runs)
OLYMPIC_SYNC_MAX_CHALLENGES=100
# Log file of sync runs and requested URLs (rotated, also printed to stderr); relative to the working directory
OLYMPIC_SYNC_LOG_FILE=logs/sync.log

# Pause between requests to BoincStats, seconds (its firewall shows a captcha when requests come too often)
OLYMPIC_REQUEST_DELAY=60
# Retries on network errors, timeouts, 5xx and 429 (with growing pauses)
OLYMPIC_REQUEST_RETRIES=3
# Pages are loaded by Chrome via nodriver (with a window: on a server run under Xvfb).
# Chrome/Chromium executable; unset -> autodetect
# OLYMPIC_BROWSER_PATH=/usr/bin/google-chrome
# false is needed for a Chromium without an AppArmor profile (e.g. not installed from a .deb)
OLYMPIC_BROWSER_SANDBOX=true

# Tests: server + base name; each run creates its own <name>_<random> database and drops it afterwards; unset -> testcontainers postgres:18
OLYMPIC_TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/olympic_boinc_test

# Elastic APM (optional). Start the observability Compose profile, then set enabled=true.
# Host application connects through the published loopback port; the container uses apm-server:8200.
OLYMPIC_APM_ENABLED=false
OLYMPIC_APM_SERVER_URL=http://127.0.0.1:8200
OLYMPIC_APM_SERVICE_NAME=olympic-boinc
OLYMPIC_APM_ENVIRONMENT=local
OLYMPIC_APM_TRANSACTION_SAMPLE_RATE=1.0
# Match OLYMPIC_APM_SECRET_TOKEN in .docker-env when authentication at intake is enabled.
# OLYMPIC_APM_SECRET_TOKEN=
